{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:importmap": "payload generate:importmap",
    "test:unit": "vitest --run tests/unit",
    "test:property": "vitest --run tests/property",
    "test:integration": "node -e \"if (process.env.RUN_DATABASE_TESTS !== 'true') { console.error('Set RUN_DATABASE_TESTS=true to run database integration tests.'); process.exit(1) }\" && vitest --run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@vercel/blob": "2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "file-type": "21.3.4",
    "framer-motion": "^12.40.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "nodemailer": "^9.0.5",
    "payload": "3.88.0",
